pipeline {
    agent {
        label 'worker'
    }

    tools {
        maven 'maven'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'dev', url: 'https://github.com/mayurpandit25/edublitz-b2b-medical-erp.git'
            }
        }

        stage('BUILD - USER-SERVICE') {
            steps {
                dir('user-service') {
                    sh '''
                    mvn clean package -DskipTests
                    '''
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'user-service/target/*.jar', fingerprint: true
                }
            }
        }

        stage('BUILD - ORDER-SERVICE') {
            steps {
                dir('order-service') {
                    sh '''
                    mvn clean package -DskipTests
                    '''
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'order-service/target/*.jar', fingerprint: true
                }
            }
        }

        stage('BUILD - PRODUCTS-SERVICE') {
            steps {
                dir('products-service') {
                    sh '''
                    mvn clean package -DskipTests
                    '''
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'products-service/target/*.jar', fingerprint: true
                }
            }
        }
    }
}











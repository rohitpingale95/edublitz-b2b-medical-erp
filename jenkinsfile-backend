pipeline {
    agent {
        label 'worker'
    }

    tools {
        maven 'maven1'
    }

    environment {
        my_aws_credential = credentials('aws-access')
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'dev', url: 'https://github.com/mayurpandit25/edublitz-b2b-medical-erp.git'
                echo 'clonning is successfull'
            }
        }

        stage('Build User-service') {
            steps {
                dir('user-service') {
                    sh 'mvn clean package -DskipTests'
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'user-service/target/*.jar', fingerprint: true
                }
            }
        }

        stage('SonarQubeAnalysis - user service') {
            steps {
                withSonarQubeEnv('sonar') {
                    dir('user-service') {
                        sh 'mvn sonar:sonar'
                    }
                }
            }
        }

        stage('Build Product-Service') {
            steps {
                dir('product-service') {
                    sh 'mvn clean package -DskipTests'
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'product-service/target/*.jar', fingerprint: true
                }
            }
        }

        stage('SonarQubeAnalysis - product service') {
            steps {
                withSonarQubeEnv('sonar') {
                    dir('product-service') {
                        sh 'mvn sonar:sonar'
                    }
                }
            }
        }

        stage('Build Order Service') {
            steps {
                dir('order-service') {
                    sh 'mvn clean package -DskipTests'
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'order-service/target/*.jar', fingerprint: true
                }
            }
        }

        stage('SonarQubeAnalysis - order service') {
            steps {
                withSonarQubeEnv('sonar') {
                    dir('order-service') {
                        sh 'mvn sonar:sonar'
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                docker build -t user-service:latest ./user-service
                docker build -t product-service:latest ./product-service 
                docker build -t order-service:latest ./order-service
                docker images
                '''
            }
        }

        stage('Push images to ECR') {
            steps {
                sh '''
                aws ecr get-login-password --region us-east-2 | docker login --username AWS --password-stdin 506995420953.dkr.ecr.us-east-2.amazonaws.com

                docker tag user-service:latest 506995420953.dkr.ecr.us-east-2.amazonaws.com/users-service:latest
                docker push 506995420953.dkr.ecr.us-east-2.amazonaws.com/users-service:latest

                docker tag product-service:latest 506995420953.dkr.ecr.us-east-2.amazonaws.com/products-service:latest
                docker push 506995420953.dkr.ecr.us-east-2.amazonaws.com/products-service:latest

                docker tag order-service:latest 506995420953.dkr.ecr.us-east-2.amazonaws.com/orders-service:latest
                docker push 506995420953.dkr.ecr.us-east-2.amazonaws.com/orders-service:latest
                '''
            }
        }
    }
}




pipeline {

    agent {
        label 'worker'
    }

    environment {
        AWS_CREDENTIALS = credentials('aws-access')
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'dev', url: 'https://github.com/mayurpandit25/edublitz-b2b-medical-erp.git'
            }
        }

        stage('Build Frontend') {
            steps {
                dir('frontend') {
                    sh '''
                        npm install
                        npm run build
                    '''
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'frontend/dist/**', fingerprint: true
                }
            }
        }

        stage('Deploy to S3') {
            steps {
                dir('frontend') {
                    sh '''
                        aws s3 sync dist/ s3://mayurcbz.space --delete
                    '''
                }
            }
        }

    post {
        success {
            echo 'Frontend deployed successfully.'
        }
        failure {
            echo 'Frontend deployment failed.'
        }
    }
}

